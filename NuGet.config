<configuration>
  <packageSources>
    <!-- Standard NuGet.org feed. Required for EF Core, Identity, JwtBearer, AspNet.Security.OAuth.Discord. -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
