<Window x:Class="Morimens.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Morimens Damage Calculator" Height="700" Width="900"
        Background="#1A1A2E">

    <Window.Resources>
        <Style TargetType="Label" x:Key="FieldLabel">
            <Setter Property="Foreground"  Value="#C0C0D0"/>
            <Setter Property="FontFamily"  Value="Segoe UI"/>
            <Setter Property="FontSize"    Value="13"/>
        </Style>
        <Style TargetType="ComboBox" x:Key="InputCombo">
            <Setter Property="Height"  Value="30"/>
            <Setter Property="Margin"  Value="0,2,0,8"/>
        </Style>
        <Style TargetType="TextBox" x:Key="InputBox">
            <Setter Property="Height"  Value="30"/>
            <Setter Property="Margin"  Value="0,2,0,8"/>
            <Setter Property="Padding" Value="4,4"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ── Input panel ────────────────────────────────────────────── -->
        <StackPanel Grid.Column="0" Margin="0,0,12,0">
            <TextBlock Text="Morimens Calculator" FontSize="20" FontWeight="Bold"
                       Foreground="White" Margin="0,0,0,16"/>

            <Label Content="Awakener" Style="{StaticResource FieldLabel}"/>
            <ComboBox x:Name="AwakenerCombo" Style="{StaticResource InputCombo}"
                      SelectionChanged="AwakenerCombo_SelectionChanged"/>

            <Label Content="Skill" Style="{StaticResource FieldLabel}"/>
            <ComboBox x:Name="SkillCombo" Style="{StaticResource InputCombo}"/>

            <Separator Margin="0,8"/>

            <Label Content="Attacker ATK (override)" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="AtkOverrideTxt" Style="{StaticResource InputBox}" PlaceholderText="Leave blank to use base ATK"/>

            <Label Content="Target DEF" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="DefTxt" Style="{StaticResource InputBox}" Text="0"/>

            <Label Content="Target Shield HP (0 = no shield)" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="ShieldHpTxt" Style="{StaticResource InputBox}" Text="0"/>

            <Label Content="DEF Factor" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="DefFactorTxt" Style="{StaticResource InputBox}" Text="1.0"/>

            <Separator Margin="0,8"/>

            <CheckBox x:Name="IsCritChk" Content="Critical Hit" Foreground="#C0C0D0"
                      FontSize="13" Margin="0,0,0,8"/>

            <Label Content="Base Crit Multiplier" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="CritMultTxt" Style="{StaticResource InputBox}" Text="1.5"/>

            <Button Content="Calculate" Height="40" Margin="0,12,0,0"
                    Background="#5C6BC0" Foreground="White" FontSize="15"
                    BorderThickness="0" Cursor="Hand"
                    Click="CalculateButton_Click"/>
        </StackPanel>

        <!-- ── Results panel ──────────────────────────────────────────── -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Summary tiles -->
            <UniformGrid Grid.Row="0" Columns="2" Margin="0,0,0,12">
                <Border Background="#16213E" CornerRadius="8" Margin="0,0,6,0" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Displayed Damage" Foreground="#8888AA" FontSize="12"/>
                        <TextBlock x:Name="DisplayedDmgTxt" Text="—" Foreground="#E0E0FF"
                                   FontSize="28" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
                <Border Background="#16213E" CornerRadius="8" Margin="6,0,0,0" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Actual Damage" Foreground="#8888AA" FontSize="12"/>
                        <TextBlock x:Name="ActualDmgTxt" Text="—" Foreground="#FFD166"
                                   FontSize="28" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Breakdown table -->
            <DataGrid Grid.Row="1" x:Name="BreakdownGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      Background="#0F0F23"
                      RowBackground="#12122A"
                      AlternatingRowBackground="#1A1A35"
                      Foreground="#C0C0D0"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Layer"   Binding="{Binding LayerName}"   Width="160"/>
                    <DataGridTextColumn Header="Before"  Binding="{Binding DamageBefore, StringFormat=N0}" Width="110"/>
                    <DataGridTextColumn Header="After"   Binding="{Binding DamageAfter,  StringFormat=N0}" Width="110"/>
                    <DataGridTextColumn Header="Notes"   Binding="{Binding Description}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</Window>
